# Generated by agra role prometheus
# OVERRIDE TEMPLATE INI DENGAN menaruh di: /etc/agra/config/prometheus/prometheus.yml.j2

global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_evaluation_interval }}
  external_labels:
    monitor: 'agra-monitor'
    cluster: 'agra'

rule_files:
  - "{{ prometheus_rules_dir }}/*.yml"
  - "{{ prometheus_rules_dir }}/*.yaml"

alerting:
  alertmanagers: []

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['{{ prometheus_web_listen_address }}']
        labels:
          instance: '{{ inventory_hostname }}'

  - job_name: 'node_exporter'
    file_sd_configs:
      - files:
          - '{{ prometheus_file_sd_dir }}/node_exporter.yml'
        refresh_interval: 30s
    scrape_interval: {{ prometheus_scrape_interval }}
    scrape_timeout: 10s
