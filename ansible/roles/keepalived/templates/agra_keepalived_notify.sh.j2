#!/bin/bash
# agra keepalived notify script — called by keepalived on state changes
# (notify_master / notify_backup / notify_fault / notify_stop). Logging only.
# A failing health check lowers priority (BACKUP), it does not cause FAULT.
# Argumen $1 = type (MASTER|BACKUP|FAULT|STOP)
set -u
LOG_FILE="{{ keepalived_log_file }}"
INSTANCE="{{ keepalived_vrrp_instance }}"
VIP="{{ monitoring_vip }}"
HOSTNAME="$(hostname)"

log() {
    local lvl="$1"; shift
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [NOTIFY ${lvl}] instance=${INSTANCE} vip=${VIP} host=${HOSTNAME} — $*" >> "${LOG_FILE}" 2>/dev/null || true
    echo "[KEEPALIVED ${lvl}] instance=${INSTANCE} vip=${VIP} host=${HOSTNAME} — $*" 1>&2 || true
}

STATE="${1:-UNKNOWN}"
case "${STATE}" in
    MASTER|master)
        log "INFO  -> STATE=MASTER (claim VIP ${VIP})"
        ;;
    BACKUP|backup)
        log "INFO  -> STATE=BACKUP (release VIP ${VIP})"
        ;;
    FAULT|fault)
        log "ERROR -> STATE=FAULT (interface down or unrecoverable error)"
        ;;
    STOP|stop)
        log "WARN  -> STATE=STOP (keepalived stopped)"
        ;;
    *)
        log "WARN  -> STATE=UNKNOWN args=\"$*\""
        ;;
esac
exit 0
