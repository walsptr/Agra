# agra keepalived config — generated by ansible role keepalived
# OVERRIDE: /etc/agra/config/keepalived/keepalived.conf.j2
# Paths below are inside the container ({{ keepalived_config_dir }} on the host
# is mounted at {{ keepalived_container_config_dir }}).
#
# Priority: {{ keepalived_priority_base }} for groups['monitoring'][0], -1 per
# position; a failing health check adds {{ keepalived_weight }}, so an unhealthy node
# always ranks below every healthy one and the VIP moves.
#
# No vrrp_strict: it rejects unicast_peer and authentication, and installs an
# iptables DROP for the VIP that would block traffic to nginx.
{%- macro unicast_ip(host) -%}
{{ hostvars[host]['keepalived_unicast_ip'] | default(hostvars[host]['ansible_host'] | default(host)) }}
{%- endmacro %}

global_defs {
    router_id agra-monitoring-{{ inventory_hostname }}
    enable_script_security
    script_user root root
    vrrp_skip_check_adv_addr
    vrrp_garp_interval 0.001
    vrrp_gna_interval 0.001
}

# Combined health check
vrrp_script {{ keepalived_script_name }} {
    script "{{ keepalived_container_config_dir }}/agra_monitoring_healthcheck.sh"
    interval {{ keepalived_check_interval }}
    timeout {{ keepalived_check_interval | int + 1 }}
    fall {{ keepalived_fall_count }}
    rise {{ keepalived_rise_count }}
    weight {{ keepalived_weight }}
}

vrrp_instance {{ keepalived_vrrp_instance }} {
    state {{ keepalived_state }}
    interface {{ monitoring_vip_interface }}
    virtual_router_id {{ keepalived_router_id }}
    priority {{ keepalived_priority }}
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass | string | trim | replace(' ', '_') | truncate(8, True, '') }}
    }

    unicast_src_ip {{ unicast_ip(inventory_hostname) }}
    unicast_peer {
{% for peer in groups['monitoring'] if peer != inventory_hostname %}
        {{ unicast_ip(peer) }}
{% endfor %}
    }

    virtual_ipaddress {
        {{ monitoring_vip }}/32 dev {{ monitoring_vip_interface }} label {{ monitoring_vip_interface }}:0
    }

    # monitoring_vip_interface is tracked implicitly (it is the instance interface).

    track_script {
        {{ keepalived_script_name }}
    }

    notify_master "{{ keepalived_container_config_dir }}/agra_keepalived_notify.sh MASTER"
    notify_backup "{{ keepalived_container_config_dir }}/agra_keepalived_notify.sh BACKUP"
    notify_fault  "{{ keepalived_container_config_dir }}/agra_keepalived_notify.sh FAULT"
    notify_stop   "{{ keepalived_container_config_dir }}/agra_keepalived_notify.sh STOP"
}
