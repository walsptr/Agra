# agra keepalived config — generated by ansible role keepalived
# OVERRIDE DENGAN menaruh di: /etc/agra/config/keepalived/keepalived.conf.j2
# DESIGN §4 Priority formula: group[0] (master) = 201 ; group[1] = 101 ; dst.

global_defs {
    notification_email {
    }
    router_id agra-monitoring-{{ inventory_hostname }}
    enable_script_security
    script_user root root
    vrrp_skip_check_adv_addr
    vrrp_strict
    vrrp_garp_interval 0
    vrrp_gna_interval 0
    max_auto_priority 99
}

# vrrp_script COMBINED HEALTHCHECK — DESIGN §4
vrrp_script {{ keepalived_script_name }} {
    script "/usr/local/bin/agra_monitoring_healthcheck.sh"
    interval {{ keepalived_check_interval }}
    fall {{ keepalived_fall_count }}
    rise {{ keepalived_rise_count }}
    weight {{ keepalived_weight }}
}

vrrp_instance {{ keepalived_vrrp_instance }} {
    state {{ keepalived_state }}
    interface {{ monitoring_vip_interface }}
    virtual_router_id {{ keepalived_router_id }}
    priority {{ keepalived_priority }}
    advert_int 1
    nopreempt_sleep 300

    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }

    unicast_src_ip {{ ansible_facts['default_ipv4']['address'] | default('0.0.0.0') }}
    unicast_peer {
{% if groups['monitoring'] is defined %}
{% for peer in groups['monitoring'] if peer != inventory_hostname %}
        {{ hostvars[peer]['ansible_host'] | default(peer) }}
{% endfor %}
{% endif %}
    }

    virtual_ipaddress {
        {{ monitoring_vip }}/32 dev {{ monitoring_vip_interface }} label {{ monitoring_vip_interface }}:0
    }

    # Track interface untuk jaga-jaga interface down
    track_interface {
        {{ monitoring_vip_interface }}
    }

    # Combined health check — DESIGN §4
    track_script {
        {{ keepalived_script_name }} weight {{ keepalived_weight }}
    }

    # Notify script untuk log transisi state (DESIGN §4.2)
    notify_master "/usr/local/bin/agra_keepalived_notify.sh MASTER"
    notify_backup "/usr/local/bin/agra_keepalived_notify.sh BACKUP"
    notify_fault  "/usr/local/bin/agra_keepalived_notify.sh FAULT"
    notify_stop   "/usr/local/bin/agra_keepalived_notify.sh STOP"
}
