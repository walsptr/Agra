#!/bin/bash
# agra Grafana SQLite Rsync — DOUBLE BUFFER sync (tarik dari MASTER → standby)
# SAFETY: (1) rsync ke .new TEMP FILE dulu (partial write OK di .new, tidak menyentuh DB aktif)
#         (2) sqlite safety check sebelum mv: PRAGMA integrity_check terhadap .new file
#         (3) baru mv ATOMIK replace grafana.db dengan .new (rename = atomic pada POSIX same FS)
# DESIGN.md §4.3: Grafana sqlite HA rsync sync
set -u
set -o pipefail

MASTER_HOST="{{ _grafana_ha_master_ip }}"
MASTER_USER="{{ grafana_sqlite_sync_ssh_user | default('root') }}"
GRAFANA_DATA_DIR="{{ grafana_data_dir }}"
DB_FILE="grafana.db"
DB_NEW="grafana.db.new"
DB_BAK="grafana.db.bak-$(date '+%Y%m%d-%H%M%S')"
LOG_FILE="/var/log/agra-grafana-sync.log"
MAX_RETRY=2
RETRY_DELAY=5

log() {
    local lvl="$1"; shift
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [RSYNC ${lvl}] master=${MASTER_HOST} data_dir=${GRAFANA_DATA_DIR} — $*" >> "${LOG_FILE}" 2>/dev/null || true
}

die() {
    log "ERROR" "$*"
    exit 1
}

# Pre-check
[ -d "${GRAFANA_DATA_DIR}" ] || die "Grafana data dir ${GRAFANA_DATA_DIR} TIDAK ADA"
which rsync sqlite3 >/dev/null 2>&1 || die "rsync ATAU sqlite3 tidak terinstall di standby node (butuh keduanya)"

cd "${GRAFANA_DATA_DIR}" || die "Tidak bisa cd ke ${GRAFANA_DATA_DIR}"

# Cleanup stale .new dari run sebelumnya (jika crash)
[ -f "${DB_NEW}" ] && {
    log "INFO  " "Cleanup stale ${DB_NEW} dari run sebelumnya"
    rm -f "${DB_NEW}" "${DB_NEW}-shm" "${DB_NEW}-wal" 2>/dev/null || true
}

attempt=1
while [ $attempt -le $MAX_RETRY ]; do
    log "INFO  " "Rsync attempt ${attempt}/${MAX_RETRY} pull ${MASTER_USER}@${MASTER_HOST}:${GRAFANA_DATA_DIR}/${DB_FILE} → ${DB_NEW}"

    # Step 1: Rsync ke TEMP grafana.db.new (partial safe)
    rsync_cmd="rsync -avz --no-whole-file --partial --inplace \
        -e 'ssh -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=yes -o UserKnownHostsFile=~/.ssh/known_hosts' \
        ${MASTER_USER}@${MASTER_HOST}:${GRAFANA_DATA_DIR}/${DB_FILE} \
        ${DB_NEW}"

    if eval "${rsync_cmd}" ; then
        log "INFO  " "Step 1/3 rsync → ${DB_NEW} OK"
        break
    else
        rc=$?
        log "WARN  " "Step 1 rsync GAGAL exit=$rc — retry setelah ${RETRY_DELAY}s"
        sleep $RETRY_DELAY
    fi
    attempt=$((attempt+1))
done
[ $attempt -gt $MAX_RETRY ] && die "MAX RETRY ${MAX_RETRY} tercapai — rsync gagal"

# Step 2: SQLite integrity check pada grafana.db.new (SEBELUM diaktifkan)
log "INFO  " "Step 2/3: PRAGMA integrity_check on ${DB_NEW}"
INTEGRITY=$(sqlite3 "${DB_NEW}" "PRAGMA integrity_check;" 2>&1) || {
    log "ERROR " "sqlite3 command integrity_check GAGAL — discard ${DB_NEW}"
    rm -f "${DB_NEW}"
    exit 1
}
if [ "${INTEGRITY}" != "ok" ]; then
    log "ERROR " "PRAGMA integrity_check TIDAK OK: ${INTEGRITY} — discard ${DB_NEW}, ABORT"
    rm -f "${DB_NEW}"
    exit 1
fi
log "INFO  " "Step 2/3 integrity_check PASSED (ok)"

# Step 3: Backup grafana.db lama → grafana.db.bak-<ts> (safety restore point)
#           → mv atomik grafana.db.new → grafana.db
if [ -f "${DB_FILE}" ]; then
    log "INFO  " "Step 3/3: Backup current ${DB_FILE} → ${DB_BAK}, mv atomik ${DB_NEW} → ${DB_FILE}"
    cp -a "${DB_FILE}" "${DB_BAK}" || {
        log "WARN  " "cp backup ke ${DB_BAK} gagal (non-fatal, lanjut mv)"
    }
fi

mv -f "${DB_NEW}" "${DB_FILE}" || die "mv ATOMIK ${DB_NEW} → ${DB_FILE} GAGAL"

# Cleanup old .bak (keep 3 latest)
ls -1t grafana.db.bak-* 2>/dev/null | tail -n +4 | while read -r oldbak; do
    log "INFO  " "Cleanup old backup: ${oldbak}"
    rm -f "${oldbak}"
done

log "INFO  " "SUKSES grafana.db sync OK, integrity ok, backup ${DB_BAK} saved"
exit 0
