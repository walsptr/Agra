# Generated by agra role grafana — datasource provisioning
# OVERRIDE: /etc/agra/config/grafana/provisioning/datasources/prometheus.yml.j2
apiVersion: 1

datasources:
  - name: {{ grafana_prometheus_datasource_name }}
    type: prometheus
    access: proxy
    orgId: 1
    uid: {{ grafana_prometheus_datasource_uid }}
    url: {{ grafana_prometheus_datasource_url }}
    isDefault: true
    editable: true
    jsonData:
      timeInterval: {{ prometheus_scrape_interval | default('15s') }}
      queryTimeout: 60s
      httpMethod: POST
      exemplarTraceIdDestinations: []
    version: 1
