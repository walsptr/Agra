# Generated by agra role nginx — Prometheus on its own domain.
# OVERRIDE: /etc/agra/config/nginx/sites-available/prometheus.conf.j2
#
# Prometheus has no auth, so nothing is published unless prometheus_domain is
# set (or expose_prometheus_via_nginx adds /prometheus/ to the Grafana site).
# The admin API and lifecycle endpoints are never proxied.
{% set _prometheus_domain_trim = (prometheus_domain | default('') | trim) %}
{% if _prometheus_domain_trim | length > 0 and enable_prometheus | default(true) | bool %}
{% if enable_https | default(true) | bool %}
server {
    listen {{ nginx_http_port }};
{% if _nginx_ipv6 | bool %}
    listen [::]:{{ nginx_http_port }};
{% endif %}
    server_name {{ _prometheus_domain_trim }};
    return 301 https://$host{{ '' if nginx_https_port | int == 443 else ':' ~ nginx_https_port }}$request_uri;
}

server {
    listen {{ nginx_https_port }} ssl;
{% if _nginx_ipv6 | bool %}
    listen [::]:{{ nginx_https_port }} ssl;
{% endif %}
    http2 on;
    server_name {{ _prometheus_domain_trim }};

    ssl_certificate     {{ _nginx_ct_ssl_dir }}/{{ 'prometheus.crt' if ((tls_prometheus_cert_path | default('') | trim | length) > 0) else 'agra.crt' }};
    ssl_certificate_key {{ _nginx_ct_ssl_dir }}/{{ 'prometheus.key' if ((tls_prometheus_key_path  | default('') | trim | length) > 0) else 'agra.key' }};
    ssl_protocols {{ tls_protocols }};
    ssl_prefer_server_ciphers {{ tls_prefer_server_ciphers }};
    ssl_session_cache {{ tls_session_cache }};
    ssl_session_timeout {{ tls_session_timeout }};

    add_header Strict-Transport-Security "max-age={{ tls_hsts_max_age }}{% if tls_hsts_include_subdomains %}; includeSubDomains{% endif %}{% if tls_hsts_preload %}; preload{% endif %}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-XSS-Protection "1; mode=block" always;
{% else %}
server {
    listen {{ nginx_http_port }};
{% if _nginx_ipv6 | bool %}
    listen [::]:{{ nginx_http_port }};
{% endif %}
    server_name {{ _prometheus_domain_trim }};
{% endif %}

    location ^~ /api/v1/admin/ {
        return 403;
    }

    location ~ ^/-/(quit|reload)$ {
        return 403;
    }

    location / {
        proxy_pass {{ (prometheus_backend_url.split() | join('')) }}/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
        proxy_connect_timeout 30;
        proxy_send_timeout 300;
        proxy_buffering off;
    }
}
{% endif %}
