{% set _prometheus_domain_trim = (prometheus_domain | default('') | trim) %}
{% set _prometheus_domain_has = (_prometheus_domain_trim | length > 0) %}
{% set _monitoring_vip_trim = (monitoring_vip | default('') | trim) %}
{% set _monitoring_vip_has = (_monitoring_vip_trim | length > 0) %}
{% set _enable_prometheus = enable_prometheus | default(true) | bool %}
{% set _prometheus_server_names_case_b = ((
  ([_monitoring_vip_trim] if _monitoring_vip_has else [])
  + [inventory_hostname]
  + ['_']
) | unique | join(' ')) %}

{% if _prometheus_domain_has %}

{% if enable_https | default(true) | bool %}
server {
    listen {{ nginx_http_port }};
    listen [::]:{{ nginx_http_port }};
    server_name {{ _prometheus_domain_trim }};
    return 301 https://$host$request_uri;
}

server {
    listen {{ nginx_https_port }} ssl;
    listen [::]:{{ nginx_https_port }} ssl;
    http2 on;
    server_name {{ _prometheus_domain_trim }};

    ssl_certificate     {{ nginx_config_dir }}/ssl/{{ 'prometheus.crt' if ((tls_prometheus_cert_path | default('') | trim | length) > 0) else 'agra.crt' }};
    ssl_certificate_key {{ nginx_config_dir }}/ssl/{{ 'prometheus.key' if ((tls_prometheus_key_path  | default('') | trim | length) > 0) else 'agra.key' }};
    ssl_protocols {{ tls_protocols }};
    ssl_prefer_server_ciphers {{ tls_prefer_server_ciphers }};
    ssl_session_cache {{ tls_session_cache }};
    ssl_session_timeout {{ tls_session_timeout }};

    add_header Strict-Transport-Security "max-age={{ tls_hsts_max_age }}{% if tls_hsts_include_subdomains %}; includeSubDomains{% endif %}{% if tls_hsts_preload %}; preload{% endif %}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-XSS-Protection "1; mode=block" always;
{% else %}
server {
    listen {{ nginx_http_port }};
    listen [::]:{{ nginx_http_port }};
    server_name {{ _prometheus_domain_trim }};
{% endif %}

    location / {
        proxy_pass {{ (prometheus_backend_url.split() | join('')) }}/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
        proxy_connect_timeout 30;
        proxy_send_timeout 300;
        proxy_buffering off;
    }

    location /api/ {
        proxy_pass {{ (prometheus_backend_url.split() | join('')) }}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
    }

    location /graph {
        proxy_pass {{ (prometheus_backend_url.split() | join('')) }}/graph;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

{% elif _enable_prometheus %}

server {
    listen {{ prometheus_nginx_port }};
    listen [::]:{{ prometheus_nginx_port }};
    server_name {{ _prometheus_server_names_case_b }};

    location / {
        proxy_pass {{ (prometheus_backend_url.split() | join('')) }}/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
        proxy_connect_timeout 30;
        proxy_send_timeout 300;
        proxy_buffering off;
    }
}

{% endif %}
