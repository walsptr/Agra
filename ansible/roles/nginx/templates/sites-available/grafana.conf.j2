{% set _grafana_domain_trim = (grafana_domain | default('') | trim) %}
{% set _grafana_domain_has = (_grafana_domain_trim | length > 0) %}
{% set _monitoring_vip_trim = (monitoring_vip | default('') | trim) %}
{% set _monitoring_vip_has = (_monitoring_vip_trim | length > 0) %}
{% set _prometheus_expose = (expose_prometheus_via_nginx | default(false) | bool) %}
{% set _grafana_server_names = ((
  ([_grafana_domain_trim] if _grafana_domain_has else [])
  + ([_monitoring_vip_trim] if _monitoring_vip_has else [])
  + [inventory_hostname]
  + (['_'] if not _grafana_domain_has else [])
) | unique | join(' ')) %}

{% if _grafana_domain_has %}

{% if enable_https | default(true) | bool %}
server {
    listen {{ nginx_http_port }};
    listen [::]:{{ nginx_http_port }};
    server_name {{ _grafana_server_names }};
    return 301 https://$host$request_uri;
}

server {
    listen {{ nginx_https_port }} ssl;
    listen [::]:{{ nginx_https_port }} ssl;
    http2 on;
    server_name {{ _grafana_server_names }};

    ssl_certificate     {{ nginx_config_dir }}/ssl/{{ 'grafana.crt' if ((tls_grafana_cert_path | default('') | trim | length) > 0) else 'agra.crt' }};
    ssl_certificate_key {{ nginx_config_dir }}/ssl/{{ 'grafana.key' if ((tls_grafana_key_path  | default('') | trim | length) > 0) else 'agra.key' }};
    ssl_protocols {{ tls_protocols }};
    ssl_prefer_server_ciphers {{ tls_prefer_server_ciphers }};
    ssl_session_cache {{ tls_session_cache }};
    ssl_session_timeout {{ tls_session_timeout }};

    add_header Strict-Transport-Security "max-age={{ tls_hsts_max_age }}{% if tls_hsts_include_subdomains %}; includeSubDomains{% endif %}{% if tls_hsts_preload %}; preload{% endif %}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-XSS-Protection "1; mode=block" always;
{% else %}
server {
    listen {{ nginx_http_port }};
    listen [::]:{{ nginx_http_port }};
    server_name {{ _grafana_server_names }};
{% endif %}

    location = / {
        return 302 /grafana/;
    }

    location /grafana/ {
        proxy_pass {{ (grafana_backend_url.split() | join('')) }}/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Authorization $http_authorization;
        proxy_pass_header Authorization;
        proxy_read_timeout 300;
        proxy_connect_timeout 30;
        proxy_send_timeout 300;
        proxy_buffering off;
    }

    location /grafana/api/live/ {
        proxy_pass {{ (grafana_backend_url.split() | join('')) }}/api/live/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
        proxy_buffering off;
    }

{% if _prometheus_expose %}
    location /prometheus/ {
        proxy_pass {{ (prometheus_backend_url.split() | join('')) }}/prometheus/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Script-Name /prometheus;
        proxy_read_timeout 300;
        proxy_connect_timeout 30;
    }

    location = /prometheus {
        return 301 /prometheus/;
    }
{% endif %}

    location / {
        try_files $uri $uri/ =404;
    }
}

{% else %}

server {
    listen {{ grafana_nginx_port }};
    listen [::]:{{ grafana_nginx_port }};
    server_name {{ _grafana_server_names }};

    location = / {
        return 302 /grafana/;
    }

    location /grafana/ {
        proxy_pass {{ (grafana_backend_url.split() | join('')) }}/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Authorization $http_authorization;
        proxy_pass_header Authorization;
        proxy_read_timeout 300;
        proxy_connect_timeout 30;
        proxy_send_timeout 300;
        proxy_buffering off;
    }

    location /grafana/api/live/ {
        proxy_pass {{ (grafana_backend_url.split() | join('')) }}/api/live/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
        proxy_buffering off;
    }

{% if _prometheus_expose %}
    location /prometheus/ {
        proxy_pass {{ (prometheus_backend_url.split() | join('')) }}/prometheus/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Script-Name /prometheus;
        proxy_read_timeout 300;
        proxy_connect_timeout 30;
    }

    location = /prometheus {
        return 301 /prometheus/;
    }
{% endif %}

    location / {
        try_files $uri $uri/ =404;
    }
}

{% endif %}
