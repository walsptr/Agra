# Generated by agra role nginx — Grafana at the root path.
# OVERRIDE: /etc/agra/config/nginx/sites-available/grafana.conf.j2
#
# Grafana is served on the standard ports with or without grafana_domain:
# HTTPS on nginx_https_port (HTTP redirects to it) when enable_https, plain
# HTTP on nginx_http_port otherwise. This site is the default_server, so the
# node IP and monitoring_vip reach Grafana without a name.
{% set _grafana_domain_trim = (grafana_domain | default('') | trim) %}
{% set _monitoring_vip_trim = (monitoring_vip | default('') | string | trim) %}
{% set _https = enable_https | default(true) | bool %}
{% set _prometheus_subpath = expose_prometheus_via_nginx | default(false) | bool %}
{% set _grafana_server_names = ((
  ([_grafana_domain_trim] if _grafana_domain_trim | length > 0 else [])
  + ([_monitoring_vip_trim] if _monitoring_vip_trim | length > 0 else [])
) | unique | join(' ')) or '_' %}
{% if _https %}
server {
    listen {{ nginx_http_port }} default_server;
{% if _nginx_ipv6 | bool %}
    listen [::]:{{ nginx_http_port }} default_server;
{% endif %}
    server_name {{ _grafana_server_names }};
    return 301 https://$host{{ '' if nginx_https_port | int == 443 else ':' ~ nginx_https_port }}$request_uri;
}

server {
    listen {{ nginx_https_port }} ssl default_server;
{% if _nginx_ipv6 | bool %}
    listen [::]:{{ nginx_https_port }} ssl default_server;
{% endif %}
    http2 on;
    server_name {{ _grafana_server_names }};

    ssl_certificate     {{ _nginx_ct_ssl_dir }}/{{ 'grafana.crt' if ((tls_grafana_cert_path | default('') | trim | length) > 0) else 'agra.crt' }};
    ssl_certificate_key {{ _nginx_ct_ssl_dir }}/{{ 'grafana.key' if ((tls_grafana_key_path  | default('') | trim | length) > 0) else 'agra.key' }};
    ssl_protocols {{ tls_protocols }};
    ssl_prefer_server_ciphers {{ tls_prefer_server_ciphers }};
    ssl_session_cache {{ tls_session_cache }};
    ssl_session_timeout {{ tls_session_timeout }};

    add_header Strict-Transport-Security "max-age={{ tls_hsts_max_age }}{% if tls_hsts_include_subdomains %}; includeSubDomains{% endif %}{% if tls_hsts_preload %}; preload{% endif %}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-XSS-Protection "1; mode=block" always;
{% else %}
server {
    listen {{ nginx_http_port }} default_server;
{% if _nginx_ipv6 | bool %}
    listen [::]:{{ nginx_http_port }} default_server;
{% endif %}
    server_name {{ _grafana_server_names }};
{% endif %}

    location / {
        proxy_pass {{ (grafana_backend_url.split() | join('')) }}/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Authorization $http_authorization;
        proxy_pass_header Authorization;
        proxy_read_timeout 300;
        proxy_connect_timeout 30;
        proxy_send_timeout 300;
        proxy_buffering off;
    }

    location /api/live/ {
        proxy_pass {{ (grafana_backend_url.split() | join('')) }}/api/live/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
        proxy_buffering off;
    }
{% if _prometheus_subpath %}

    # Prometheus has no auth: never proxy its admin API (TSDB delete/snapshot)
    # or the lifecycle endpoints that stop/reload it.
    location ^~ /prometheus/api/v1/admin/ {
        return 403;
    }

    location ~ ^/prometheus/-/(quit|reload)$ {
        return 403;
    }

    # The prefix is stripped: Prometheus serves at / and only its links carry
    # /prometheus/ (--web.external-url, roles/prometheus/tasks/config.yml).
    location /prometheus/ {
        proxy_pass {{ (prometheus_backend_url.split() | join('')) }}/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
        proxy_connect_timeout 30;
    }

    location = /prometheus {
        return 301 /prometheus/;
    }
{% endif %}
}
