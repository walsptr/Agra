{% set _deploy = (agra_deployment_mode | default('native')) %}
{% if _deploy == 'docker' %}
user {{ nginx_container_user }};
{% else %}
user {{ nginx_native_user }};
{% endif %}
worker_processes {{ nginx_worker_processes }};
pid {{ nginx_pid_path }};

error_log {{ nginx_log_dir }}/error.log warn;

events {
    worker_connections {{ nginx_worker_connections }};
    use epoll;
    multi_accept on;
}

http {
    include {{ nginx_config_dir }}/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log {{ nginx_log_dir }}/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout {{ nginx_keepalive_timeout }};
    types_hash_max_size 2048;
    server_tokens off;
    client_max_body_size {{ nginx_client_max_body_size }};

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/json application/javascript;

    ssl_protocols {{ tls_protocols }};
    ssl_ciphers '{{ tls_ciphers }}';
    ssl_prefer_server_ciphers {{ tls_prefer_server_ciphers }};
    ssl_session_cache {{ tls_session_cache }};
    ssl_session_timeout {{ tls_session_timeout }};
    ssl_session_tickets {{ tls_session_tickets }};
    resolver_timeout 5s;

    # ══════════════════════════════════════════════════════════════════════════
    # SSL CERTIFICATES DITENTUKAN PER SERVER BLOCK DI sites-available/agra-monitoring.conf.j2
    # (Scalable multi-domain (Grafana + Prometheus dedicated, each cert DAPAT ssl berbeda)
    # ══════════════════════════════════════════════════════════════════════════

    # ══════════════════════════════════════════════════════════════════════════
    # SSL STAPLING CONDITIONAL (FIX nginx warn "issuer certificate not found"):
    # OCSP Stapling HANYA BERMANFAAT dan VALID untuk SERTIFIKAT CA-SIGNED PUBLIC
    # yang memiliki Intermediate/Root CA Chain.
    # Default self-signed cert (issuer = dirinya sendiri) TIDAK PUNYA OCSP URL
    # sehingga ssl_stapling on → nginx WARN "issuer certificate not found".
    #
    # LOGIKA PRECEDENCE (EXPLICIT user OVERRIDE selalu menang!):
    #   1. JIKA user set enable_ssl_stapling=true  di globals.yml → PAKSA ON
    #   2. JIKA user set enable_ssl_stapling=false di globals.yml → PAKSA OFF
    #   3. JIKA user TIDAK SET variabel (undefined) → AUTO DETECT:
    #        ON  JIKA tls_ca_path TERISI (CA chain tersedia = CA-signed cert)
    #        OFF JIKA tls_ca_path KOSONG (default self-signed)
    #
    # CATATAN: SSL certificates SEKARANG didefinisikan PER SERVER BLOCK di
    # sites-available/*.conf (bukan global), jadi stapling detect hanya berdasarkan
    # ada/tidaknya CA chain path global (tls_ca_path).
    # ══════════════════════════════════════════════════════════════════════════
    {% set _stapling_user_set = (enable_ssl_stapling is defined and enable_ssl_stapling is not none and (enable_ssl_stapling | string | length > 0)) %}
    {% set _ca_clean_global = ((tls_ca_path | default('')).split() | join('')) if (tls_ca_path | default('') and (tls_ca_path | default('')).split() | join('')) else '' %}
    {% if _stapling_user_set %}
    {% set _stapling = (enable_ssl_stapling | bool) %}
    {% else %}
    {% set _stapling = (_ca_clean_global | length > 0) %}
    {% endif %}
    {% if _stapling %}
    ssl_stapling on;
    ssl_stapling_verify on;
    {% endif %}

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    include {{ nginx_sites_enabled_dir }}/*.conf;
    include {{ nginx_confd_dir }}/*.conf;
}
