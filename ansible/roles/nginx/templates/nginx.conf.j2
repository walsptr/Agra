user {{ nginx_container_user }};
worker_processes {{ nginx_worker_processes }};
pid {{ nginx_pid_path }};

error_log {{ _nginx_ct_log_dir }}/error.log warn;

events {
    worker_connections {{ nginx_worker_connections }};
    use epoll;
    multi_accept on;
}

http {
    include {{ _nginx_ct_config_dir }}/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log {{ _nginx_ct_log_dir }}/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout {{ nginx_keepalive_timeout }};
    types_hash_max_size 2048;
    server_tokens off;
    client_max_body_size {{ nginx_client_max_body_size }};

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/json application/javascript;

    ssl_protocols {{ tls_protocols }};
    ssl_ciphers '{{ tls_ciphers }}';
    ssl_prefer_server_ciphers {{ tls_prefer_server_ciphers }};
    ssl_session_cache {{ tls_session_cache }};
    ssl_session_timeout {{ tls_session_timeout }};
    ssl_session_tickets {{ tls_session_tickets }};
    resolver_timeout 5s;

    # Certificates are set per server block (sites-available/*.conf.j2).
    # OCSP stapling (_nginx_stapling, tasks/config.yml): enable_ssl_stapling,
    # else on only when a CA chain was copied. nginx resolves the OCSP
    # responder itself, so stapling always comes with a resolver.
{% if _nginx_stapling | default(false) | bool %}
    ssl_stapling on;
    ssl_stapling_verify on;
{% if _nginx_ca_present | default(false) | bool %}
    ssl_trusted_certificate {{ _nginx_ct_ssl_dir }}/agra-ca.crt;
{% endif %}
    resolver {{ _nginx_resolvers | join(' ') }} valid=300s{{ '' if _nginx_ipv6 | bool else ' ipv6=off' }};
{% endif %}

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    include {{ _nginx_ct_config_dir }}/sites-enabled/*.conf;
    include {{ _nginx_ct_config_dir }}/conf.d/*.conf;
}
