# Generated by agra role nginx — local liveness endpoint for the keepalived
# combined health check. Loopback only: never exposed.
# OVERRIDE: /etc/agra/config/nginx/conf.d/agra-healthz.conf.j2
server {
    listen 127.0.0.1:{{ nginx_health_port }};
    access_log off;

    location = /healthz {
        return 200 "ok\n";
    }

    location / {
        return 404;
    }
}
