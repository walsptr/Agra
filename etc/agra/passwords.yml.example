---
# /etc/agra/passwords.yml — AGRA SECRETS (plaintext, mode 0600). JANGAN commit.
#
# Template KOSONG: install.sh menyalinnya ke /etc/agra/passwords.yml (jika
# belum ada), lalu `agra genpwd` mengisi field yang masih kosong. Daftar field
# WAJIB sinkron dengan ansible/playbooks/genpwd.yml (genpwd_fields).

# --- Dibuat agra genpwd (genpwd_fields) ---
# Password admin Grafana (precheck: >= 8 karakter, bukan "admin").
grafana_admin_password: ""
# Password database eksternal Grafana (mysql/postgresql) — set juga di database.
grafana_database_password: ""
# Grafana [security] secret_key. JANGAN diganti setelah deploy: data terenkripsi
# di database Grafana (password datasource, dsb.) jadi tidak terbaca.
grafana_secret_key: ""
# Keepalived VRRP auth_pass (maksimal 8 karakter).
keepalived_auth_pass: ""

# --- Diisi operator (genpwd_operator_fields) — kredensial dari provider S3 ---
# Hanya perlu jika backup_s3_enabled: true.
backup_s3_access_key: ""
backup_s3_secret_key: ""
